# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# mount point        fstype      device                                  flags

# Logical Partitions
/system             emmc         /dev/block/mapper/system                flags=display="System";backup=1
/system_ext         emmc         /dev/block/mapper/system_ext            flags=display="System EXT";backup=1
/system_dlkm        emmc         /dev/block/mapper/system_dlkm           flags=display="System DLKM";backup=1
/product            emmc         /dev/block/mapper/product               flags=display="Product";backup=1
/vendor             emmc         /dev/block/mapper/vendor                flags=display="Vendor";backup=1
/vendor_dlkm        emmc         /dev/block/mapper/vendor_dlkm           flags=display="Vendor DLKM";backup=1
/odm                emmc         /dev/block/mapper/odm                  flags=display="ODM";backup=1
/odm_dlkm           emmc         /dev/block/mapper/odm_dlkm             flags=display="ODM DLKM";backup=1

# Boot Partitions
/boot               emmc         /dev/block/by-name/boot                flags=display="Boot";backup=1;flashimg=1
/init_boot          emmc         /dev/block/by-name/init_boot           flags=display="Init Boot";backup=1;flashimg=1
/vendor_boot        emmc         /dev/block/by-name/vendor_boot         flags=display="Vendor Boot";backup=1;flashimg=1
/dtbo               emmc         /dev/block/by-name/dtbo                flags=display="DTBO";backup=1;flashimg=1

# AVB Partitions
/vbmeta             emmc         /dev/block/by-name/vbmeta              flags=display="VBMeta";flashimg=1
/vbmeta_system      emmc         /dev/block/by-name/vbmeta_system       flags=display="VBMeta System";flashimg=1
/vbmeta_vendor      emmc         /dev/block/by-name/vbmeta_vendor       flags=display="VBMeta Vendor";flashimg=1

# Device Partitions
/persistent         emmc         /dev/block/by-name/frp
/misc               emmc         /dev/block/by-name/misc
/nvcfg              ext4         /dev/block/by-name/nvcfg               flags=display="NVCFG"
/nvdata             ext4         /dev/block/by-name/nvdata              flags=display="NVData"
/persist            ext4         /dev/block/by-name/persist             flags=display="Persist"
/protect_f          ext4         /dev/block/by-name/protect1            flags=display="Protect F"
/protect_s          ext4         /dev/block/by-name/protect2            flags=display="Protect S"
/blackbox           ext4         /dev/block/by-name/blackbox            flags=display="Blackbox"
/elabel             ext4         /dev/block/by-name/elabel              flags=display="Elabel"

# Firmware Partitions
/gz                 emmc         /dev/block/by-name/gz
/lk                 emmc         /dev/block/by-name/lk                  flags=display="Bootloader";flashimg=1
/logo               emmc         /dev/block/by-name/logo                flags=display="Logo";flashimg=1
/modem              emmc         /dev/block/by-name/modem               flags=display="Modem";flashimg=1
/scp                emmc         /dev/block/by-name/scp
/spmfw              emmc         /dev/block/by-name/spmfw
/sspm               emmc         /dev/block/by-name/sspm
/tee                emmc         /dev/block/by-name/tee                 flags=display="TEE";flashimg=1

# Factory Partitions
/boot_para          emmc         /dev/block/by-name/boot_para
/efuse              emmc         /dev/block/by-name/efuse
/expdb              emmc         /dev/block/by-name/expdb
/flashinfo          emmc         /dev/block/by-name/flashinfo
/mrdump             emmc         /dev/block/by-name/mrdump
/nvram              emmc         /dev/block/by-name/nvram
/otp                emmc         /dev/block/by-name/otp
/para               emmc         /dev/block/by-name/para
/proinfo            emmc         /dev/block/by-name/proinfo
/seccfg             emmc         /dev/block/by-name/seccfg

# Internal Storage
/storage            f2fs         /data/media/0                           flags=display="Internal Storage";backup=1;usermrf;fsflags="bind";removable

# External storage
/external_sd		vfat		/dev/block/mmcblk1p1		/dev/block/mmcblk1		flags=display="MicroSD Card";storage;wipeingui;removable;fsflags="utf8"
/usb-otg		vfat		/dev/block/sda1			/dev/block/sda			flags=display="USB-OTG";storage;wipeingui;removable;fsflags="utf8"

